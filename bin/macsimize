#!/usr/bin/env bash
# macsimize — make a Mac behave like an always-on server, reversibly.
#
#   macsimize setup [--yes] [--dry-run]  full first-time setup (reachability + mode)
#   macsimize server [--dry-run]         stay awake, load caffeinate guard
#   macsimize laptop [--dry-run]         restore original power behavior
#   macsimize status                     show current mode (read-only, no sudo)
#   macsimize boot-agent install|remove  install/remove the on-boot re-asserter
#   macsimize help
#
# `setup` is the turnkey entrypoint; server/laptop are the day-to-day toggle.
# The toggle changes only the power layer + the caffeinate guard and records the
# chosen mode; the boot-agent persists across both modes and re-asserts whichever
# mode was last set (state/desired-mode) on each boot.
# DRY_RUN is assigned in main() but consumed inside lib/common.sh
# (run/is_dry_run), which ShellCheck can't see across the dynamic source.
# shellcheck disable=SC2034
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SELF_DIR/../lib/common.sh"
# shellcheck source=../lib/power.sh
source "$SELF_DIR/../lib/power.sh"
# shellcheck source=../lib/caffeinate.sh
source "$SELF_DIR/../lib/caffeinate.sh"
# shellcheck source=../lib/reassert.sh
source "$SELF_DIR/../lib/reassert.sh"
# shellcheck source=../lib/tailscale.sh
source "$SELF_DIR/../lib/tailscale.sh"
# shellcheck source=../lib/mosh.sh
source "$SELF_DIR/../lib/mosh.sh"
# shellcheck source=../lib/prefs.sh
source "$SELF_DIR/../lib/prefs.sh"
# shellcheck source=../lib/setup.sh
source "$SELF_DIR/../lib/setup.sh"

usage() {
  cat <<'EOF'
macsimize — make a Mac behave like an always-on server, reversibly.

  macsimize setup [--yes] [--dry-run]   full first-time setup (reachability + mode)
  macsimize server [--dry-run]          stay awake, load caffeinate guard
  macsimize laptop [--dry-run]          restore original power behavior
  macsimize status                      show current mode (read-only, no sudo)
  macsimize boot-agent install|remove   install/remove the on-boot re-asserter
  macsimize help

`setup` installs + configures reachability (Tailscale, SSH, mosh), asks about a
couple of reboot preferences, and flips into server mode. server/laptop are the
day-to-day toggle: they change only the power layer + caffeinate guard and record
the chosen mode, which the boot-agent re-asserts on each boot.
EOF
}

cmd_server() {
  need_cmd pmset
  log "entering SERVER mode  (profile: $(host_profile))"
  set_desired_mode server
  snapshot_power
  apply_server_power
  caffeinate_install
  echo
  ok "SERVER mode active."
  cmd_status
  echo
  log "reachability (Tailscale / SSH / mosh) is one-time setup, not this toggle:"
  dim "  - full turnkey setup:    bin/macsimize setup"
  dim "  - enable + harden SSH:   scripts/ssh-enable-harden.sh"
  dim "  - tailnet DNS/hostname:  scripts/dns-hostname-fix.sh (usually not needed)"
}

cmd_laptop() {
  need_cmd pmset
  log "entering LAPTOP mode"
  set_desired_mode laptop
  caffeinate_uninstall
  restore_power || true
  echo
  ok "LAPTOP mode active (SSH, if enabled, is left on by design)."
  cmd_status
}

cmd_boot_agent() {
  case "${1:-}" in
    install) reassert_install ;;
    remove|uninstall) reassert_uninstall ;;
    *) die "usage: macsimize boot-agent install|remove" ;;
  esac
}

cmd_status() {
  # Verdict: infer mode from the two things server-mode changes.
  local ds caff mode
  ds="$(_read_ac_key disablesleep)"
  if caffeinate_is_loaded; then caff=1; else caff=0; fi
  if [ "$ds" = "1" ] && [ "$caff" = "1" ]; then
    mode="SERVER ✅  (staying awake, lid-close safe)"
  elif [ "$ds" != "1" ] && [ "$caff" = "0" ]; then
    mode="LAPTOP 💤  (normal sleep behavior)"
  else
    mode="PARTIAL ⚠️  (disablesleep=$ds, caffeinate=$caff — run 'macsimize server' or 'laptop')"
  fi
  echo "macsimize: $mode"
  echo
  echo "indicators (host profile: $(host_profile)):"
  echo "power (AC):"
  power_status
  caffeinate_status
  reassert_status
  # Reachability (read-only): SSH, Tailscale, mosh.
  if launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
    echo "  ssh (Remote Login): ON"
  else
    echo "  ssh (Remote Login): off/unknown"
  fi
  tailscale_status
  mosh_status
}

main() {
  local sub="${1:-help}"; shift || true
  # Collect subargs; pull out --dry-run globally. `setup` parses its own flags
  # (e.g. --yes), so pass everything else through to it untouched.
  local rest=()
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN=1 ;;
      *) rest+=("$arg") ;;
    esac
  done
  # setup prints its own dry-run banner; the toggle commands announce it here.
  if [ "$sub" != "setup" ]; then is_dry_run && warn "DRY-RUN: no changes will be made"; fi
  case "$sub" in
    setup) cmd_setup "${rest[@]:-}" ;;
    server) cmd_server ;;
    laptop) cmd_laptop ;;
    status) cmd_status ;;
    boot-agent) cmd_boot_agent "${rest[@]:-}" ;;
    help|-h|--help) usage ;;
    *) err "unknown command: $sub"; echo; usage; exit 2 ;;
  esac
}

main "$@"
