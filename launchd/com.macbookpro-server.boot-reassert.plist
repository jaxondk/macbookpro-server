<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macbookpro-server.boot-reassert</string>

  <!-- On each login/boot, re-assert whichever mode was last set (state/desired-mode).
       Insurance in case a macOS update or anything else reset the pmset profile.
       __SERVERMODE_REPO__ is replaced with the repo path at install time. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SERVERMODE_REPO__/scripts/boot-reassert.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <!-- One-shot: run once at boot, don't relaunch. -->
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/servermode-boot-reassert.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/servermode-boot-reassert.log</string>
</dict>
</plist>
