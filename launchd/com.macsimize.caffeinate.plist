<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macsimize.caffeinate</string>

  <!-- `caffeinate -s` asserts "prevent system sleep", but ONLY while on AC
       power, so this agent itself does not hold on battery. NOTE: that does
       NOT mean an unplugged laptop sleeps — the pmset `disablesleep` flag is
       global and keeps the machine awake on battery regardless (known
       limitation; flip to laptop mode before unplugging). This agent is just
       the belt-and-suspenders guard on top of the pmset profile. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
  </array>

  <!-- Start at login and relaunch if it ever exits. As a LaunchAgent this
       runs in the user session (no sudo to install), which is fine given
       FileVault stays on and reboots require a manual unlock anyway. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/macsimize-caffeinate.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/macsimize-caffeinate.log</string>
</dict>
</plist>
