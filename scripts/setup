#!/usr/bin/env bash
# setup — turn this Mac into a reachable always-on server, end to end.
#
# This is the one command a new user runs. It installs and configures what's
# needed, ASKS about the few personal-taste decisions (auto-updates, FileVault,
# the boot agent), does everything it safely can, and prints the steps only you
# can finish by hand. Re-runnable and idempotent.
#
#   scripts/setup              # interactive
#   scripts/setup --yes        # accept the recommended default for every prompt
#   scripts/setup --dry-run    # print every action, change nothing (uses defaults)
#
# What this repo owns (and this script sets up): staying awake, reachability
# (Tailscale config, SSH, mosh-server), the reversible server/laptop toggle, a
# boot re-asserter, and the reboot-surprise preferences. It does NOT manage your
# dev environment (packages, shell, editors, agent config) — that's your
# dotfiles' job. See the README.
#
# DRY_RUN / ASSUME_YES / _c_* colors are assigned in lib/common.sh, sourced
# below; ShellCheck can't follow that dynamic source, hence the file disables.
# shellcheck disable=SC2034,SC2154
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SELF_DIR/../lib/common.sh"
# shellcheck source=../lib/tailscale.sh
source "$SELF_DIR/../lib/tailscale.sh"
# shellcheck source=../lib/mosh.sh
source "$SELF_DIR/../lib/mosh.sh"
# shellcheck source=../lib/prefs.sh
source "$SELF_DIR/../lib/prefs.sh"

SERVERMODE="$SELF_DIR/../bin/servermode"

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --yes|-y)  ASSUME_YES=1 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown flag: $arg (try --dry-run, --yes)" ;;
  esac
done
# A dry run shouldn't block on prompts; use the recommended defaults.
is_dry_run && ASSUME_YES=1

# Steps the user must finish by hand get appended here and printed at the end.
MANUAL=()
manual() { MANUAL+=("$*"); }

log "macsimize setup — host profile: $(host_profile)  ($(scutil --get LocalHostName 2>/dev/null || echo '?'))"
is_dry_run && warn "DRY-RUN: no changes will be made"
echo

# --- 1. Tailscale (reachability) --------------------------------------------
log "1/6  Tailscale — private, stable address to reach this box"
fresh_ts=0
if tailscale_is_installed; then
  ok "already installed ($(ts_bin))"
elif is_dry_run; then
  dim "[dry-run] would install standalone Tailscale (brew install --cask tailscale)"
elif tailscale_install; then
  fresh_ts=1
else
  manual "Install Tailscale (standalone) from https://tailscale.com/download/macos, then re-run scripts/setup."
fi

if tailscale_is_installed && [ "$fresh_ts" = "0" ]; then
  if is_dry_run; then
    dim "[dry-run] would run: tailscale set --ssh=true --accept-dns=false"
  elif tailscale_is_up; then
    tailscale_configure && ok "Tailscale configured for server use"
  else
    warn "Tailscale is installed but not logged in."
    manual "Authenticate + configure Tailscale:  $(ts_bin) up --ssh --accept-dns=false   (opens a browser login)"
  fi
elif [ "$fresh_ts" = "1" ]; then
  warn "Tailscale was just installed — a one-time GUI approval is required."
  manual "Open Tailscale.app once and approve the system extension / VPN config in System Settings, then run:  $(ts_bin) up --ssh --accept-dns=false"
fi
manual "In the Tailscale admin console, DISABLE key expiry for this machine (or tag it) so a headless node never logs itself off the tailnet."
echo

# --- 2. mosh-server (reachability for mobile clients) -----------------------
log "2/6  mosh — resilient mobile sessions (Moshi, Blink, …)"
if is_dry_run; then
  if mosh_is_installed; then ok "mosh-server present"; else dim "[dry-run] would install mosh (brew install mosh)"; fi
else
  mosh_install || manual "Install mosh:  brew install mosh"
fi
echo

# --- 3. SSH / Remote Login --------------------------------------------------
log "3/6  SSH — enable Remote Login"
if is_dry_run; then
  dim "[dry-run] would enable Remote Login (scripts/ssh-enable-harden.sh; prompts for sudo)"
elif launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
  ok "Remote Login already ON"
elif ask_yn "Enable SSH / Remote Login (needed to connect in)" y; then
  "$SELF_DIR/ssh-enable-harden.sh" || manual "Enable SSH manually:  sudo systemsetup -setremotelogin on"
else
  manual "Enable SSH when ready:  scripts/ssh-enable-harden.sh"
fi
manual "Optional hardening: lock SSH to key-only (lockout risk, do it carefully):  scripts/ssh-enable-harden.sh --check  then follow its printed steps."
echo

# --- 4. Reboot-surprise preferences (your call) -----------------------------
log "4/6  Preferences — reduce surprise reboots (your call)"

# 4a. macOS automatic updates (they reboot).
if autoupdate_is_disabled; then
  ok "automatic macOS updates already disabled"
elif is_dry_run; then
  dim "[dry-run] would offer to disable automatic macOS updates (default: yes)"
elif ask_yn "Disable automatic macOS updates? They reboot the box unexpectedly (recommended for a server)" y; then
  autoupdate_disable || manual "Disable auto-updates:  sudo defaults write $SU_DOMAIN AutomaticallyInstallMacOSUpdates -bool false"
else
  dim "leaving automatic macOS updates as-is (expect occasional reboots)."
fi

# 4b. FileVault — informational + preference captured, never auto-toggled.
echo
dim "$(filevault_status_line)"
if filevault_is_on; then
  dim "  ON keeps a portable/stealable laptop safe, but a reboot stops at the unlock"
  dim "  screen until someone types the password (SSH/daemons don't start until then)."
  if is_dry_run; then
    dim "[dry-run] would ask whether to keep FileVault on (default: keep on)"
  elif ask_yn "Keep FileVault ON? (recommended for a laptop)" y; then
    ok "keeping FileVault on"
    manual "For a PLANNED reboot that returns reachable without a keyboard:  sudo fdesetup authrestart"
  else
    warn "turning FileVault off re-encrypts the whole disk — not something this script will do for you."
    manual "Turn FileVault OFF yourself (slow; unencrypts the boot disk, enables unattended reboots):  sudo fdesetup disable"
  fi
else
  dim "  off means reboots come back unattended, but the boot disk is unencrypted."
fi
echo

# --- 5. Boot re-assert agent (your call) ------------------------------------
log "5/6  Boot re-assert agent — re-apply your mode after every reboot/update"
want_boot_agent=0
if is_dry_run; then
  dim "[dry-run] would offer to install the boot re-assert agent (default: yes)"
  want_boot_agent=1
elif ask_yn "Install the boot re-assert agent? Re-applies server/laptop mode on each boot (no sudo)" y; then
  want_boot_agent=1
else
  dim "skipping the boot agent — a reboot won't re-apply server mode on its own."
fi

# --- 6. Server mode ----------------------------------------------------------
log "6/6  Server mode — stay awake (lid-close safe)"
if is_dry_run; then
  [ "$want_boot_agent" = "1" ] && "$SERVERMODE" boot-agent install --dry-run
  "$SERVERMODE" server --dry-run
else
  [ "$want_boot_agent" = "1" ] && "$SERVERMODE" boot-agent install
  "$SERVERMODE" server
fi

# pmset grant note (install is sensitive → printed, not auto-run).
if ! sudo -n pmset -g >/dev/null 2>&1; then
  manual "Optional: install the scoped pmset grant so toggling needs no password (one sudo prompt; grants NOPASSWD for /usr/bin/pmset ONLY):
    sed \"s/__USER__/\$(id -un)/\" scripts/sudoers-pmset > /tmp/sm-sudoers && \\
      sudo visudo -cf /tmp/sm-sudoers && \\
      sudo install -m 0440 -o root -g wheel /tmp/sm-sudoers /etc/sudoers.d/macbookpro-server-pmset && \\
      rm -f /tmp/sm-sudoers"
fi
echo

# --- Summary ----------------------------------------------------------------
log "setup complete — current state:"
echo
if is_dry_run; then
  dim "(dry-run: nothing changed)"
else
  "$SERVERMODE" status
fi
echo
if [ "${#MANUAL[@]}" -gt 0 ]; then
  printf '%s==> STEPS ONLY YOU CAN DO%s  (the rest is done)\n' "$_c_yellow" "$_c_reset"
  n=1
  for m in "${MANUAL[@]}"; do
    printf '  %d. %s\n' "$n" "$m"
    n=$((n + 1))
  done
else
  ok "nothing left for you to do — fully set up."
fi
echo
dim "Reverse everything:  bin/servermode laptop  &&  bin/servermode boot-agent remove"
