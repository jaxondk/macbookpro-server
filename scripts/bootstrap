#!/usr/bin/env bash
# bootstrap — read-only preflight: is this Mac ready for `macsimize setup`?
#
# This repo owns ONLY server behavior. Your dev environment (packages, shell,
# agentic config) is owned by your chezmoi dotfiles — run `chezmoi apply` first.
# bootstrap changes nothing; it checks prerequisites and points you at setup.
#
#   scripts/bootstrap            # check prerequisites + print next step
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SELF_DIR/../lib/common.sh"

log "bootstrap — host profile: $(host_profile)  ($(scutil --get LocalHostName 2>/dev/null || echo '?'))"

check() { if command -v "$1" >/dev/null 2>&1; then ok "$1"; else warn "missing: $1"; fi; }

log "dev-environment tools (provided by your dotfiles, NOT this repo):"
for c in git tmux herdr claude; do check "$c"; done

log "reachability tools (installed for you by 'macsimize setup'):"
for c in tailscale mosh; do check "$c"; done

# chezmoi applied?
if command -v chezmoi >/dev/null 2>&1; then
  ok "chezmoi present"
else
  warn "chezmoi not found — run your dotfiles install first (dev env won't be set up)."
fi

# passwordless pmset?
if sudo -n pmset -g >/dev/null 2>&1; then
  ok "passwordless pmset grant active"
else
  warn "no passwordless pmset grant — 'macsimize' will prompt for sudo without it (optional)."
fi

cat <<EOF

Next:
  bin/macsimize setup          # ← turnkey: Tailscale + mosh + SSH + server mode, with a next-steps summary
  bin/macsimize status         # see current state anytime

Already set up reachability? Just flip the mode:
  bin/macsimize server
EOF
